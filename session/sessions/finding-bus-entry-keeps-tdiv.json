{
  "name": "finding-bus-entry-keeps-tdiv",
  "about": "Entering BUS with its F-key, and with the web's workspace switch, keeps the time/div the scope had",
  "relays": false,
  "signals": {
    "C1": {"kind": "uart", "rate": 9600, "vpp": 3.3, "offset": 1.65, "text": "hello"},
    "C2": {"kind": "dc", "offset": 0}
  },
  "start": {"rows": {"time.tdiv": "200us", "trig.level": "1.65V"}},
  "steps": [
    {"check": {"name": "scope", "fields": ["workspace", "row.time.tdiv", "tdiv_s"]}},
    {"key": "f2"},
    {"check": {"name": "bus-key", "fields": ["workspace", "view", "row.time.tdiv", "tdiv_s", "row.bus.protocol"],
      "expect": {"workspace": {"eq": "bus"}, "row.time.tdiv": {"same_as": "scope"}}}},
    {"workspace": "scope"},
    {"check": {"name": "scope-again", "fields": ["workspace", "row.time.tdiv"],
      "expect": {"row.time.tdiv": {"same_as": "scope"}}}},
    {"workspace": "bus"},
    {"check": {"name": "bus-web", "fields": ["workspace", "view", "row.time.tdiv", "tdiv_s"],
      "expect": {"workspace": {"eq": "bus"}, "row.time.tdiv": {"same_as": "scope"}}}}
  ]
}
