{
  "name": "bus-views",
  "about": "BUS's F-key again cycles Packets, Eye and the other views on a decoded UART",
  "relays": false,
  "signals": {
    "C1": {"kind": "uart", "rate": 115200, "vpp": 3.3, "offset": 1.65, "hex": "48692055aa0ff00a"},
    "C2": {"kind": "dc", "offset": 0}
  },
  "start": {"rows": {"trig.level": "1.65V", "time.tdiv": "200us", "bus.protocol": "UART", "bus.baud": "115k2"}},
  "steps": [
    {"workspace": "bus"},
    {"check": {"name": "bus", "fields": ["workspace", "view", "fkeys", "again", "row.bus.protocol", "packets"], "tol": {"packets": "present"}}},
    {"key": "f2"},
    {"check": {"name": "again1", "fields": ["workspace", "view", "fkeys", "again"]}},
    {"key": "f2"},
    {"check": {"name": "again2", "fields": ["workspace", "view", "fkeys", "again"]}}
  ]
}
