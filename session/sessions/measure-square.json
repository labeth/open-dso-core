{
  "name": "measure-square",
  "about": "Frequency, peak-to-peak and duty of a 10 MHz 3.3 V square on C1, from the MEAS rows and the frame; the levels are a bench source's (its own high and low, within 15 % or 0.2 V of the nominal) and the edges a front end's (rise, fall and ringing within their tolerances)",
  "relays": false,
  "signals": {"C1": {"kind": "square", "hz": 10e6, "vpp": 3.3, "offset": 1.65}},
  "start": {"rows": {"time.tdiv": "100ns", "trig.level": "1.65V", "meas.freq": "C1", "meas.pkpk": "C1", "meas.duty": "C1"}},
  "steps": [
    {"workspace": "measure"},
    {"check": {"name": "readings",
      "fields": ["workspace", "view", "meas.", "fmeas.ch1.", "row.time.tdiv"],
      "tol": {"meas.": "rel:0.05", "fmeas.": "rel:0.05", "meas.pkpk.": "rel:0.15", "fmeas.ch1.vpp": "rel:0.15", "fmeas.ch1.vmax": "abs:0.4", "fmeas.ch1.vmin": "abs:0.4", "fmeas.ch1.vmean": "abs:0.3", "fmeas.ch1.vrms": "rel:0.15",
        "meas.ampl.": "rel:0.15", "meas.top.": "rel:0.15", "meas.max.": "rel:0.15", "meas.mean.": "rel:0.15", "meas.rms.": "rel:0.15", "meas.acrms.": "rel:0.15",
        "meas.base.": "abs:0.2", "meas.min.": "abs:0.2",
        "meas.rise.": "rel:0.3", "meas.fall.": "rel:0.3", "meas.ovsh.": "abs:8", "meas.prsh.": "abs:8"},
      "expect": {"workspace": {"eq": "measure"}}}}
  ]
}
